.env
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.wav

# Build-Artefakte
build/
dist/
build.txt
packaging/version_info.txt
packaging/build.local.json
*.spec.bak
*.egg-info/

# Caches und Berichte von Entwicklungswerkzeugen
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# Editor- und Betriebssystem-Dateien
.idea/
.vscode/
Thumbs.db
.DS_Store

# Nutzerdaten — gehören NIE ins Repository.
# Der Regelfall liegt ohnehin außerhalb des Projekts (%APPDATA%\Fleech bzw.
# ~/.config/Fleech); diese Zeilen sind der Fangschutz, falls doch einmal eine
# Datenbank, ein Log oder eine Einstellungsdatei im Projektordner landet.
*.db
*.db-journal
*.log
settings.json
# Fleechs eigene Sicherungen der Einstellungen (.bak, Temp-Dateien beim Speichern,
# datierte Kopien) enthalten dieselben Daten wie settings.json.
settings.json.*
sicherungen/

# Private Arbeitsnotizen — gehören NIE ins Repository.
docs/*briefing*

# Lokale Werkzeug-Konfiguration
.claude/

# Schlüsseldateien jeder Art — gehören NIE ins Repository.
*.pem
*.key
